<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.dynamisengine</groupId><artifactId>dynamisgpu-parent</artifactId><version>1.4.0</version></parent>
  <artifactId>dynamis-gpu-metal</artifactId>
  <name>DynamisGPU Native Metal</name>
  <dependencies>
    <dependency><groupId>org.dynamisengine</groupId><artifactId>dynamis-gpu-api</artifactId></dependency>
    <dependency><groupId>org.dynamisengine</groupId><artifactId>dynamis-gpu-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <profiles>
    <profile><id>metal-native</id>
      <build><plugins><plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
        <executions><execution><id>metal-bridge</id><phase>generate-resources</phase><goals><goal>exec</goal></goals>
          <configuration><executable>sh</executable><arguments><argument>${project.basedir}/src/main/native/build.sh</argument></arguments></configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
