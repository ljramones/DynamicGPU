<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
           http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.dynamisengine</groupId>
    <artifactId>dynamis-parent</artifactId>
    <version>1.0.1</version>
    <relativePath/>
  </parent>

  <groupId>org.dynamisengine</groupId>
  <artifactId>dynamisgpu-parent</artifactId>
  <version>1.0.2</version>
  <packaging>pom</packaging>
  <name>DynamisGPU Parent</name>
  <description>Headless Metal and Vulkan compute and GPU resource services for Dynamis Engine.</description>
  <url>https://github.com/ljramones/DynamicGPU</url>
  <scm>
    <connection>scm:git:https://github.com/ljramones/DynamicGPU.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/ljramones/DynamicGPU.git</developerConnection>
    <url>https://github.com/ljramones/DynamicGPU</url>
    <tag>v1.0.2</tag>
  </scm>

  <modules>
    <module>dynamis-gpu-api</module>
    <module>dynamis-gpu-vulkan</module>
    <module>dynamis-gpu-metal</module>
    <module>dynamis-gpu-test</module>
    <module>dynamis-gpu-bench</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <lwjgl.version>3.4.1</lwjgl.version>
    <lwjgl.natives>natives-linux</lwjgl.natives>
    <junit.version>5.11.0</junit.version>
    <jmh.version>1.37</jmh.version>
    <compute.metal.required>false</compute.metal.required>
    <compute.vulkan.required>false</compute.vulkan.required>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- LWJGL BOM -->
      <dependency>
        <groupId>org.lwjgl</groupId>
        <artifactId>lwjgl-bom</artifactId>
        <version>${lwjgl.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Internal modules -->
      <dependency>
        <groupId>org.dynamisengine</groupId>
        <artifactId>dynamis-gpu-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.dynamisengine</groupId>
        <artifactId>dynamis-gpu-vulkan</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.dynamisengine</groupId>
        <artifactId>dynamis-gpu-test</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.dynamisengine</groupId>
        <artifactId>dynamis-gpu-metal</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- JUnit -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
      </dependency>
      <!-- JMH -->
      <dependency>
        <groupId>org.openjdk.jmh</groupId>
        <artifactId>jmh-core</artifactId>
        <version>${jmh.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjdk.jmh</groupId>
        <artifactId>jmh-generator-annprocess</artifactId>
        <version>${jmh.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>enforce-java</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <compute.metal.required>${compute.metal.required}</compute.metal.required>
            <compute.vulkan.required>${compute.vulkan.required}</compute.vulkan.required>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>mac-arm64</id>
      <activation>
        <os><family>mac</family><arch>aarch64</arch></os>
      </activation>
      <properties><lwjgl.natives>natives-macos-arm64</lwjgl.natives></properties>
    </profile>
    <profile>
      <id>mac-x64</id>
      <activation>
        <os><family>mac</family><arch>x86_64</arch></os>
      </activation>
      <properties><lwjgl.natives>natives-macos</lwjgl.natives></properties>
    </profile>
    <profile>
      <id>linux-arm64</id>
      <activation>
        <os><family>unix</family><arch>aarch64</arch><name>Linux</name></os>
      </activation>
      <properties><lwjgl.natives>natives-linux-arm64</lwjgl.natives></properties>
    </profile>
    <profile>
      <id>windows-x64</id>
      <activation>
        <os><family>windows</family><arch>amd64</arch></os>
      </activation>
      <properties><lwjgl.natives>natives-windows</lwjgl.natives></properties>
    </profile>
    <profile>
      <id>metal-hardware</id>
      <properties><compute.metal.required>true</compute.metal.required></properties>
    </profile>
    <profile>
      <id>vulkan-hardware</id>
      <properties><compute.vulkan.required>true</compute.vulkan.required></properties>
    </profile>
  </profiles>
</project>
